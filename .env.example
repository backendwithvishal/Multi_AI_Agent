# TripMate AI — Environment Configuration Template

# Application Environment (development / production)
APP_ENV=development
LOG_LEVEL=INFO

# Security & Authentication
API_KEY=
AUTH_REQUIRED=false
ALLOWED_ORIGINS=*

# AI & LLM Provider Keys
GROQ_API_KEY=

# MCP & External Tool Keys
TAVILY_API_KEY=
OPENWEATHER_API_KEY=
AVIATIONSTACK_API_KEY=

# PostgreSQL Persistence (Optional in development, recommended in production)
DATABASE_URL=

# Performance & Rate Limits
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=1000
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Service Timeouts (Seconds)
LLM_TIMEOUT_SECONDS=30.0
MCP_TIMEOUT_SECONDS=15.0
EXTERNAL_API_TIMEOUT_SECONDS=10.0
