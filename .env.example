# ==============================================================================
# TripMate AI — Complete Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific credentials:
#   cp .env.example .env
#
# Generate cryptographically secure tokens via:
#   openssl rand -hex 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Metadata & Environment Modes
# ------------------------------------------------------------------------------
APP_NAME=TripMate AI Multi-Agent Backend Engine
APP_VERSION=3.0.0
APP_ENV=development
ENV=dev
LOG_LEVEL=INFO

# Documentation endpoints in production (disabled by default in prod)
ENABLE_DOCS_IN_PROD=false

# ------------------------------------------------------------------------------
# 2. Server & Process Concurrency
# ------------------------------------------------------------------------------
PORT=8000
WEB_CONCURRENCY=2
GRACEFUL_TIMEOUT=30
KEEP_ALIVE=5

# ------------------------------------------------------------------------------
# 3. Authentication & Access Control
# ------------------------------------------------------------------------------
AUTH_REQUIRED=false
API_KEY=your-master-api-key-here
JWT_SECRET_KEY=dev_jwt_secret_key_change_in_prod
ADMIN_REGISTRATION_SECRET=your-admin-registration-secret-here
APPROVAL_TTL_SECONDS=900

# ------------------------------------------------------------------------------
# 4. Network, Proxies & CORS Security
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_PROXIES=127.0.0.1,::1

# ------------------------------------------------------------------------------
# 5. Input Limits & Data Hygiene
# ------------------------------------------------------------------------------
MAX_REQUEST_BODY_BYTES=1048576
MAX_MESSAGE_LENGTH=2000
MAX_FEEDBACK_LENGTH=1000
THREAD_ID_REGEX=^[a-zA-Z0-9_-]{8,128}$

# ------------------------------------------------------------------------------
# 6. Cost & Rate Abuse Control
# ------------------------------------------------------------------------------
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
DAILY_TOKEN_BUDGET_PER_USER=100000
EMERGENCY_IN_MEMORY_RATE_LIMIT=5
FAIL_OPEN_REDIS=false
LANGGRAPH_RECURSION_LIMIT=15
MAX_PARALLEL_AGENTS=4

# ------------------------------------------------------------------------------
# 7. LLM & AI Providers
# ------------------------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key-here
FAST_LLM_MODEL=llama-3.1-8b-instant
REASONING_LLM_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_FAST_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_REASONING_MODEL=meta-llama/llama-3.3-70b-instruct:free

HUGGINGFACE_API_KEY=your-huggingface-api-key-here
HUGGINGFACE_FAST_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
HUGGINGFACE_REASONING_MODEL=meta-llama/Llama-3.3-70B-Instruct

# ------------------------------------------------------------------------------
# 8. Model Context Protocol (MCP) & External Tool Services
# ------------------------------------------------------------------------------
TAVILY_API_KEY=your-tavily-api-key-here
OPENWEATHER_API_KEY=your-openweather-api-key-here
AVIATIONSTACK_API_KEY=your-aviationstack-api-key-here
TOOL_ALLOWED_HOSTS=api.openweathermap.org,mcp.tavily.com,api.aviationstack.com,api.groq.com,openrouter.ai
MAX_TOOL_OUTPUT_BYTES=50000
MCP_CACHE_TTL_SECONDS=3600
MCP_CACHE_MAX_BYTES=65536

# ------------------------------------------------------------------------------
# 9. Observability & Tracing (LangSmith, Prometheus & OpenTelemetry)
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langchain-smith-key-here
LANGCHAIN_PROJECT=tripmate-ai
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
CAPTURE_PROMPTS=false
OTEL_ENABLED=false
METRICS_PROTECTED=true
METRICS_TOKEN=
METRICS_ALLOWED_IPS=127.0.0.1,::1,testclient

# ------------------------------------------------------------------------------
# 10. Persistence & Distributed Caching
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tripmate_db
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=1000

DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=10.0

# ------------------------------------------------------------------------------
# 11. Execution Timeouts (Seconds)
# ------------------------------------------------------------------------------
LLM_TIMEOUT_SECONDS=30.0
MCP_TIMEOUT_SECONDS=15.0
EXTERNAL_API_TIMEOUT_SECONDS=10.0
