# ==============================================================================
# TripMate AI — Complete Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific credentials:
#   cp .env.example .env
#
# Generate cryptographically secure tokens via:
#   openssl rand -hex 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Environment & Modes
# ------------------------------------------------------------------------------
# ENV or APP_ENV: 'dev' / 'development', 'prod' / 'production', or 'test'
ENV=dev
APP_ENV=development
LOG_LEVEL=INFO

# Documentation endpoints in production (disabled by default in prod)
ENABLE_DOCS_IN_PROD=false

# ------------------------------------------------------------------------------
# 2. Authentication & Access Control
# ------------------------------------------------------------------------------
# Enforce authentication barriers across all endpoints (enforced automatically in prod)
AUTH_REQUIRED=false

# Master administrative API key (generate with: openssl rand -hex 32)
API_KEY=your-master-api-key-here

# Secret header token required for registering new admin users (openssl rand -hex 32)
ADMIN_REGISTRATION_SECRET=your-admin-registration-secret-here

# Secret key used for signing JWT access tokens (openssl rand -hex 32)
JWT_SECRET_KEY=your-jwt-signing-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ------------------------------------------------------------------------------
# 3. Network & CORS Security
# ------------------------------------------------------------------------------
# Explicit list of allowed CORS origins (comma-separated).
# CRITICAL: Wildcard '*' is NEVER permitted when credentials are used or in production!
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Trusted reverse-proxy IP addresses or CIDR blocks (comma-separated).
# Client IP headers (X-Forwarded-For, X-Real-IP) will only be honored if the request peer is trusted.
TRUSTED_PROXIES=127.0.0.1,::1

# ------------------------------------------------------------------------------
# 4. Input Limits & Data Hygiene
# ------------------------------------------------------------------------------
# Maximum incoming HTTP request body size in bytes (1MB default = 1048576)
MAX_REQUEST_BODY_BYTES=1048576

# Maximum characters allowed for user travel prompts
MAX_MESSAGE_LENGTH=2000

# Maximum characters allowed for human-in-the-loop revision feedback
MAX_FEEDBACK_LENGTH=1000

# Strict regex pattern for validating conversation thread identifiers
THREAD_ID_REGEX=^[a-zA-Z0-9_-]{8,128}$

# ------------------------------------------------------------------------------
# 5. Cost & Rate Abuse Control
# ------------------------------------------------------------------------------
# Maximum requests per client IP / user within the window
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Daily LLM token budget per user (sliding 24h allocation)
DAILY_TOKEN_BUDGET_PER_USER=100000

# Emergency fallback rate limit cap (req/min) when Redis is unreachable for LLM routes
EMERGENCY_IN_MEMORY_RATE_LIMIT=5

# Whether to fail-open (true) or fail-closed (false) when Redis is down (default: false for LLM routes)
FAIL_OPEN_REDIS=false

# LangGraph state machine recursion loop ceiling
LANGGRAPH_RECURSION_LIMIT=15

# Maximum parallel specialist agents invoked concurrently
MAX_PARALLEL_AGENTS=5

# ------------------------------------------------------------------------------
# 6. LLM & AI Providers
# ------------------------------------------------------------------------------
# Primary hardware-accelerated model provider (Groq)
GROQ_API_KEY=your-groq-api-key-here
FAST_LLM_MODEL=llama-3.1-8b-instant
REASONING_LLM_MODEL=llama-3.3-70b-versatile

# Secondary failover provider (OpenRouter)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_FAST_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_REASONING_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Tertiary failover provider (Hugging Face Serverless)
HUGGINGFACE_API_KEY=your-huggingface-api-key-here
HUGGINGFACE_FAST_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
HUGGINGFACE_REASONING_MODEL=meta-llama/Llama-3.3-70B-Instruct

# ------------------------------------------------------------------------------
# 7. Model Context Protocol (MCP) & External Tool Services
# ------------------------------------------------------------------------------
# Hotel & destination search MCP
TAVILY_API_KEY=your-tavily-api-key-here

# Weather forecasting MCP
OPENWEATHER_API_KEY=your-openweather-api-key-here

# Flight & airline status MCP
AVIATIONSTACK_API_KEY=your-aviationstack-api-key-here

# Allowlisted outbound HTTP hostnames for MCP and tool fetches (SSRF protection)
TOOL_ALLOWED_HOSTS=api.openweathermap.org,mcp.tavily.com,api.aviationstack.com

# Maximum byte payload accepted from external tool responses
MAX_TOOL_OUTPUT_BYTES=50000

# ------------------------------------------------------------------------------
# 8. Observability & Tracing (LangSmith)
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langchain-smith-key-here
LANGCHAIN_PROJECT=tripmate-ai
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ------------------------------------------------------------------------------
# 9. Persistence & Distributed Caching
# ------------------------------------------------------------------------------
# PostgreSQL database connection URL for checkpointer, users, and audit logs
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tripmate_db

# Redis connection URL for distributed rate limiting and response caching
REDIS_URL=redis://localhost:6379/0

# In-memory and cache TTL settings
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=1000

# ------------------------------------------------------------------------------
# 10. Execution Timeouts (Seconds)
# ------------------------------------------------------------------------------
LLM_TIMEOUT_SECONDS=30.0
MCP_TIMEOUT_SECONDS=15.0
EXTERNAL_API_TIMEOUT_SECONDS=10.0
